{
  "name": "pi-webui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "PI_WEBUI_DEV=1 bun --watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && bun build server/index.ts --target=bun --external @earendil-works/pi-coding-agent --outfile=dist/server.js && bun build extensions/pi-webui.ts --target=node --packages=external --outfile=dist/pi-webui-extension.js && bun build scripts/cli.ts --target=bun --outfile=dist/cli.js && bun scripts/licenses.ts",
    "start": "bun dist/server.js",
    "cli": "bun dist/cli.js",
    "setup": "bun dist/cli.js setup",
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke:pi": "bun tests/pi-smoke.ts",
    "smoke:live": "bun tests/live-smoke.ts",
    "bridge:install": "bun scripts/install-bridge.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "preact": "^10.29.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
